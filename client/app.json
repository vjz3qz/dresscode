{
  "expo": {
    "name": "DressCode",
    "slug": "dresscode",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "dresscode",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash2.png",
      "resizeMode": "contain",
      "backgroundColor": "#E4E2DE"
    },
    "ios": {
      "bundleIdentifier": "com.dresscodeapp.dresscode",
      "supportsTablet": true,
      "requireFullScreen": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires access to the camera to allow users to upload outfit images.",
        "NSMicrophoneUsageDescription": "This app requires access to the microphone for voice-based features.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload images.",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save images to your photo library.",
        "NSUserTrackingUsageDescription": "This app collects user activity data to improve recommendations.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:yourapp.com",
        "applinks:auth.dresscode.com",
        "applinks:yourapp.com",
        "applinks:auth.dresscode.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/splash2.png",
        "backgroundColor": "#E4E2DE"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/splash2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "86be4339-23d6-48b4-aaee-5c672eb2764e"
      }
    },
    "owner": "vjz3qz"
  },
  "updates": {
    "enabled": true,
    "checkAutomatically": "ON_LOAD"
  }
}
